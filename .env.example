# Copy to .env and fill in. Never commit .env.
GEMINI_API_KEY=GEMINI_API_KEY
DATABASE_URL="MY_DATABASE_URL"

GROUP_JID=120363xxxxxxxxxx@g.us
PEER_BOT_SENDER=9198xxxxxxxxxx@s.whatsapp.net
BOT_TO_BOT_MAX_TURNS=20
AGENT_URL=http://127.0.0.1:8100

GATEWAY_PORT=8090
LINK_PHONE_NUMBER=
# Operator console: your personal number's JID (from a [recv] line). Consent
# prompts and YES/NO/LIST/STOP commands run through this DM — reliable transport.
OPERATOR_JID=120363xxxxxxxxxx@g.us
# Your personal number (digits only) — needed for consent-poll vote decryption
OPERATOR_PHONE=
# Optional: a private chat (1:1) the bot may message on its own (for scripts/initiate.py dm)
DM_JID=

GEMINI_MODEL=gemini-3.5-flash-lite
# Optional: override the fallback chain (comma-separated, tried in order after the primary)
# GEMINI_FALLBACK_MODELS=gemini-3.6-flash,gemini-3.8-flash

# Optional cross-provider last resort (used when ALL Google models fail).
# Get a free key at https://openrouter.ai — free models end with ':free'.
OPENROUTER_API_KEY=OPENROUTER_API_KEY
OPENROUTER_MODELS=z-ai/glm-5.2:free,google/gemma-4-31b-it:free,qwen/qwen3.8-27b:free
